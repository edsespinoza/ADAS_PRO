# ADAS PRO — Variáveis de ambiente
# Copie para .env.local e preencha com suas credenciais de DESENVOLVIMENTO
# NUNCA commite .env.local

# Supabase (projeto de staging/dev)
SUPABASE_URL=https://SEU-PROJETO-DEV.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-de-desenvolvimento

# Habilitar modo demo (apenas em dev)
DEMO_ENABLED=true
