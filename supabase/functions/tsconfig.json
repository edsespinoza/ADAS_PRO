{
  "compilerOptions": {
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": [],
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}