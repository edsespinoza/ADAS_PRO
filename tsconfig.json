{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false
  },
  "include": ["js/**/*.js", "js/**/*.ts", "supabase/**/*.ts"],
  "exclude": ["node_modules"]
}
