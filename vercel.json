{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/membros.html",
      "destination": "/membros",
      "permanent": true
    },
    {
      "source": "/superadmin.html",
      "destination": "/superadmin",
      "permanent": true
    },
    {
      "source": "/mfa-verify.html",
      "destination": "/mfa-verify",
      "permanent": true
    },
    {
      "source": "/reset-password.html",
      "destination": "/reset-password",
      "permanent": false
    },
    {
      "source": "/email-config.html",
      "destination": "/email-config",
      "permanent": false
    },
    {
      "source": "/lgpd.html",
      "destination": "/lgpd",
      "permanent": false
    },
    {
      "source": "/certifications.html",
      "destination": "/certifications",
      "permanent": false
    },
    {
      "source": "/api-docs.html",
      "destination": "/api-docs",
      "permanent": false
    },
    {
      "source": "/verificar.html",
      "destination": "/verificar",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/membros",
      "destination": "/membros.html"
    },
    {
      "source": "/superadmin",
      "destination": "/superadmin.html"
    },
    {
      "source": "/mfa-verify",
      "destination": "/mfa-verify.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/email-config",
      "destination": "/email-config.html"
    },
    {
      "source": "/lgpd",
      "destination": "/lgpd.html"
    },
    {
      "source": "/certifications",
      "destination": "/certifications.html"
    },
    {
      "source": "/api-docs",
      "destination": "/api-docs.html"
    },
    {
      "source": "/verificar",
      "destination": "/verificar.html"
    }
  ],
  "headers": [
    {
      "source": "/:page(admin|membros|superadmin|login|index|mfa-verify|reset-password|email-config|lgpd|certifications|api-docs|verificar)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:page(admin|membros|superadmin|login|index|mfa-verify|reset-password|email-config|lgpd|certifications|api-docs|verificar).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(js|css|assets|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-0k3AugSq14Z4oWrI5C3G0tCsg6vb8H1hcrKsJeYWvVA=' 'sha256-9QLrFUc7KmA28CSEVWIZUoxyrs04pVMUn1XJFpLGndA=' 'sha256-Bt6TxHzFkHaubMw7ccPFy6OZsABdidyaHtsk8kigngA=' 'sha256-IOYy9hF2Ii3uyuSXZcHQv2NzfNwQyI71TzqNQuE74j8=' 'sha256-PJKdfH65gHwYSqMTIImRnLDcKWLSk2erMvle8QdOyQA=' 'sha256-QKYLB0v57V1OllWdqwk9uAwnLKIuO5bjPPJYYnKn0Fo=' 'sha256-UIVGfCdkSf8ap8ykfzGrLI3ErIlIuGoPWVLb9RhX65w=' 'sha256-eOs1ubQvTgcCa7ojtZO3B/XCJIfLhO74+zk73dTo/3c=' 'sha256-meb5Kgt+nEQXpiKfYgvkrQtAcHs88tGOOoGeo2DRgnU=' 'sha256-qWOBQHS0z9SOLN0zC7M/M8F2MOtCKJrhziEjsqDDu7Y=' 'sha256-wRuykwYCqV9ZCo21yFAb43AEJbHyjwwy17qwmd86pSM=' 'sha256-zOdLPoNRM4c/wffY/ERJjl6H//ED4p1Tv0DDuQgKZzQ='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://zqydyyticvtmirjzskly.supabase.co wss://zqydyyticvtmirjzskly.supabase.co https://vitals.vercel-insights.com https://va.vercel-scripts.com https://api.pwnedpasswords.com https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self'; manifest-src 'self'; media-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
